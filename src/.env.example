# GRIDGUARD AI - Environment Configuration Example

# PostgreSQL / Supabase Database Connection String (Direct or Pooler Connection)
# Example: postgresql://postgres.nktnkixnvphuloabpjwb:[PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://user:password@localhost:5432/gridguard_db

# Backend Fast API Server Options
API_PORT=8000
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# IBM Bob Assistant & Gemini AI API Configuration (Optional: Dynamic fallback rule-engine active if omitted)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Application Mode
DEMO_MODE=false
